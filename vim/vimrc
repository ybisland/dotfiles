" may not work using Windows terminal
" 移动当前行或选中的行向上
function! MoveLineUp()
    if line('.') == 1
        " 如果已经是文件的第一行，则不做任何操作
        return
    endif
    normal! "zddkP
endfunction

" 移动当前行或选中的行向下
function! MoveLineDown()
    if line('.') == line('$')
        " 如果已经是文件的最后一行，则不做任何操作
        return
    endif
    normal! "zddp
endfunction

" 为 Normal 和 Visual 模式设置映射
nnoremap <a-j> :call MoveLineDown()<CR>
nnoremap <a-k> :call MoveLineUp()<CR>
vnoremap <a-j> :<C-U>call MoveLineDown()<CR>
vnoremap <a-k> :<C-U>call MoveLineUp()<CR>



