" ============================

" commentary
" Define a dictionary of comment strings for various filetypes
let g:commentStrings = {
            \ 'c': '//',
            \ 'cpp': '//',
            \ 'javascript': '//',
            \ 'python': '#',
            \ 'sh': '#',
            \ 'lua': '--',
            \ 'vim': '\"'
            \ }

function! ToggleCommentLine(line, commentMarkStyle)
    " Get the comment string for the current filetype
    let l:commentString = get(g:commentStrings, &filetype, '')
    if l:commentString == ''
        echo "No comment string defined for this filetype"
        return
    endif

    " Check if the line is commented
    if getline(a:line) =~ '^' . l:commentString
        " Uncomment the line when comment is at the start of line
        execute a:line . 's/^' . l:commentString . ' \?\(\s*\)/\1/'
    elseif getline(a:line) =~ '^\s*' . l:commentString
        " Uncomment the line when comment is after whitespace
        execute a:line . 's/^\(\s*\)' . l:commentString . ' \?/\1/'
    else " Two comment style
        if a:commentMarkStyle == 1
            " Comment out the line by placing comment before whitespace
            execute a:line . 's/^\(\s*\)/' . l:commentString . ' \1/'
        else
            " Comment out the line by placing comment after whitespace
            execute a:line . 's/^\(\s*\)/\1' . l:commentString . ' /'
        endif
    endif
endfunction

function! ToggleCommentRange(start, end)
    " Get the comment string for the current filetype
    let l:commentString = get(g:commentStrings, &filetype, '')
    if l:commentString == ''
        echo "No comment string defined for this filetype"
        return
    endif
    let l:space = ' '

    let l:flag = 0 " 0 need to uncomment; 1 need to comment
    let l:cnt = 0
    " if there is at least 1 line that isn't commented, the selected lines will be comment.
    for l:line in range(a:start, a:end)
        if getline(l:line) !~ '^\s*' . l:commentString
            let l:flag = 1
            break
        endif
    endfor

    if l:flag == 1 " range comment
        for l:line in range(a:start, a:end)
            " Comment out the line by placing comment before whitespace
            execute l:line . 's/^\(\s*\)/' . l:commentString . ' \1/'
        endfor
    else  " range uncomment
        for l:line in range(a:start, a:end)
            if getline(l:line) =~ '^' . l:commentString
                " Uncomment the line when comment is at the start of line
                execute l:line . 's/^' . l:commentString . ' \?\(\s*\)/\1/'
            elseif getline(l:line) =~ '^\s*' . l:commentString
                " Uncomment the line when comment is after whitespace
                execute l:line . 's/^\(\s*\)' . l:commentString . ' \?/\1/'
            endif
        endfor
    endif
endfunction


