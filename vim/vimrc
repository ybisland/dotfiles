"*****************************
"  brackets auto-completion
"  {} curly braces; <> angle brackets;
"  () parentheses; [] brackets;
"  ' " single/double quation 
"*****************************
" inoremap <TAB> <c-r>=SkipRightAll()<CR>
inoremap ( ()<ESC>i
inoremap ) <c-r>=SkipRightParentheses()<CR>
inoremap [ []<ESC>i
inoremap ] <c-r>=SkipRightBrackets()<CR>
inoremap { {}<ESC>i
inoremap {<CR> {<CR>}<ESC>O
inoremap } <c-r>=SkipRightBraces()<CR>

inoremap ' <c-r>=SkipQuotation1()<CR>
inoremap " <c-r>=SkipQuotation2()<CR>

func SkipRightAll()  
    if getline('.')[col('.') - 1] == ')' || getline('.')[col('.') - 1] == ']' || getline('.')[col('.') - 1] == '"' || getline('.')[col('.') - 1] == "'" || getline('.')[col('.') - 1] == '}'  
        return "\<ESC>la"  
    else  
        return "\t"  
    endif  
endfunc  
func SkipRightParentheses()
    if getline('.')[col('.') - 1] == ')'
        return "\<ESC>la"
    else
        return ")"
    endif
endfunc
func SkipRightBrackets()
    if getline('.')[col('.') - 1] == ']'
        return "\<ESC>la"
    else
        return "]"
    endif
endfunc
func SkipRightAngleBrackets()
    if getline('.')[col('.') - 1] == '>'
        return "\<ESC>la"
    else
        return ">"
    endif
endfunc
func SkipRightBraces()
    if getline('.')[col('.') - 1] == '}'
        return "\<ESC>la"
    else
        return "}"
    endif
endfunc
func SkipQuotation1()
    if getline('.')[col('.') - 1] == "'"
        return "\<ESC>la"
    else
        return "''\<ESC>i"
    endif
endfunc
func SkipQuotation2()
    if &filetype == 'vim'
        return "\""
    endif
    if getline('.')[col('.') - 1] == '"'
        return "\<ESC>la"
    else
        return "\"\"\<ESC>i"
    endif
endfunc


